{
  "name": "wavedrom-schema",
  "version": "0.5.0",
  "description": "JSON schema for WaveDrom",
  "main": "lib/",
  "unpkg": "waveschema.js",
  "scripts": {
    "test": "eslint lib/ test/ && c8 -r text -r lcov mocha",
    "build": "esbuild lib/index.js --bundle --format=iife --global-name=waveschema --footer:js=\"(function(r){if(typeof define=='function'&&define.amd){define([],()=>waveschema)}else if(typeof module=='object'&&module.exports){module.exports=waveschema}else{r.waveschema=waveschema}})(typeof self!=='undefined'?self:this);\" --outfile=waveschema.js",
    "prepare": "node bin/prepare.js && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wavedrom/wavedrom-schema.git"
  },
  "keywords": [
    "WaveDrom"
  ],
  "files": [
    "lib",
    "*.md",
    "waveschema.js",
    "waveschema.json"
  ],
  "author": "Aliaksei Capyzhenka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wavedrom/wavedrom-schema/issues"
  },
  "homepage": "https://github.com/wavedrom/wavedrom-schema#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bit-field": "^1.11.0",
    "logidrom": "^1.2.0"
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3"
  }
}
